<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.heyi.modules.system.mapper.OrganizationMapper">

    <resultMap id="BaseResultMap" type="com.heyi.publics.entity.Organization">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="type" property="type"/>
        <result column="parent_id" property="parentId"/>
        <result column="head" property="head"/>
        <result column="depth" property="depth"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted_at" property="deletedAt"/>
    </resultMap>

    <select id="selectByParentId" resultMap="BaseResultMap">
        SELECT id, name, type, parent_id, head, depth, sort_order,
               created_by, updated_by, created_at, updated_at, deleted_at
        FROM sys_organization
        WHERE parent_id = #{parentId} AND deleted_at = 0
        ORDER BY sort_order ASC, id ASC
    </select>
</mapper>
