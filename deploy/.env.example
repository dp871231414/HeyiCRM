# ================= 一键部署环境变量 =================
# 复制为 .env 后按需修改：cp .env.example .env

# ---- 数据库 ----
POSTGRES_DB=fleet_dashboard
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change-this-db-password

# ---- 后端 ----
ENV=production
DEBUG=false
# 生产环境请替换为随机长字符串（至少 32 位）：openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32+char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_SECURE=false

# ---- 演示数据 ----
# 首次启动自动写入种子数据（幂等，已有数据会跳过）。生产环境首次启动后建议置为 0
AUTO_SEED=1
# 种子账号初始密码
SEED_PASSWORD=Demo#2026

# ---- 端口 ----
WEB_PORT=8080
