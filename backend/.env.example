# ===== 应用 =====
APP_NAME=合一重卡生态经营看板
ENV=production
DEBUG=false

# ===== 数据库（PostgreSQL）=====
# 生产：postgresql+psycopg://user:password@db:5432/fleet_dashboard
DATABASE_URL=postgresql+psycopg://fleet:fleet_pwd@localhost:5432/fleet_dashboard
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ===== 鉴权 =====
# 生产环境必须替换为随机长字符串（至少 32 位）
JWT_SECRET=change-me-to-a-random-32+char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_SECURE=false

# ===== 业务口径（留空 = 按服务器当天推导；固定演示口径时再设置）=====
# CURRENT_PERIOD=2026-10
# DATA_AS_OF=2026-10-10

# ===== 跨域（前后端分离部署时使用；同源 Nginx 反代可留空）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 导入限制 =====
IMPORT_MAX_MB=5
IMPORT_MAX_ROWS=2000
