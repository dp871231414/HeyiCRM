# ===== 应用 =====
APP_NAME=合一重卡生态经营看板
ENV=production
DEBUG=false

# ===== 数据库 =====
# 开箱即用：本地/单容器用 SQLite（零依赖）
DATABASE_URL=sqlite:///./app.db
# 生产多实例：切换 PostgreSQL（需安装 requirements-postgres.txt）
# DATABASE_URL=postgresql+psycopg://user:password@db:5432/fleet_dashboard
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ===== 单容器托管（可选）=====
# 指向前端构建产物目录，由后端同源托管 SPA；留空则前后端分离（Nginx 托管前端）
# STATIC_DIR=./static

# ===== 鉴权 =====
# 生产环境必须替换为随机长字符串（至少 32 位）
JWT_SECRET=change-me-to-a-random-32+char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_SECURE=false

# ===== 业务口径（留空 = 按服务器当天推导；固定演示口径时再设置）=====
# CURRENT_PERIOD=2026-10
# DATA_AS_OF=2026-10-10

# ===== 跨域（前后端分离部署时使用；同源 Nginx 反代可留空）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 导入限制 =====
IMPORT_MAX_MB=5
IMPORT_MAX_ROWS=2000
