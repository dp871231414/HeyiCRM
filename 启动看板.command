#!/bin/bash
# 合一重卡经营看板 · 双击入口
#
# 本文件只做一件事：转调同目录的「启动看板.sh」。
# 真正的启动逻辑在 .sh 里 —— 因为 macOS 的 .command 扩展名不被多数编辑器 /
# 预览器识别，放在 .sh 中便于直接查看与修改。
#
# 双击本文件即可启动；也可以直接执行 ./启动看板.sh

cd "$(dirname "$0")" || exit 1

if [ ! -f "启动看板.sh" ]; then
  printf "\033[1;31m[失败]\033[0m 找不到 启动看板.sh（应与本文件在同一目录）\n"
  if [ -t 0 ]; then read -r -p "按回车关闭窗口…" _; fi
  exit 1
fi

# 用 bash 显式调用，避免依赖 .sh 的执行权限（从压缩包解压后权限可能丢失）
exec bash "启动看板.sh" "$@"
